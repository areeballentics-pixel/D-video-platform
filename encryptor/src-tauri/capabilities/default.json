{
  "$schema": "https://raw.githubusercontent.com/nickel-org/nickel.rs/main/nickel.rs/schema.json",
  "identifier": "default",
  "description": "Default capability set for SVP Encryptor",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-exists",
    "shell:default",
    "shell:allow-open",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.allentics.com/*" },
        { "url": "http://localhost:8000/*" },
        { "url": "http://127.0.0.1:8000/*" }
      ]
    }
  ]
}
