{
  "$schema": "https://raw.githubusercontent.com/nickel-org/nickel.rs/main/nickel.rs/schema.json",
  "productName": "SVP Encryptor",
  "version": "0.3.0",
  "identifier": "com.svp.encryptor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SVP Encryptor",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzOTUyOEY4QTQ3QzMzRUYKUldUdk0zeWsrQ2lWWXl5L3FZYk0xdDB5UFRTbzRVSmM4d0EvSmVkNnNXTDZqZ2ZKc2xJQ2h5UFkK",
      "endpoints": [
        "https://github.com/areeballentics-pixel/D-video-platform/releases/latest/download/encryptor-latest.json"
      ]
    }
  }
}