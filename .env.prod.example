# ══════════════════════════════════════════════════════════════════
#  Production environment for docker-compose.prod.yml
#  Copy to `.env` on the VPS, then fill in the real values.
# ══════════════════════════════════════════════════════════════════

# ── Your API domain (Caddy will auto-issue HTTPS for this) ────────
# Create an A record pointing this to your VPS public IP BEFORE
# running `docker compose up`, otherwise the Let's Encrypt challenge
# will fail.
DOMAIN=api.yourplatform.com

# ── Postgres (internal to docker-compose — pick any values) ───────
POSTGRES_USER=svp
POSTGRES_PASSWORD=CHANGE-ME-long-random-string
POSTGRES_DB=secure_video_platform

# ── JWT signing secret ────────────────────────────────────────────
# Generate on the VPS: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE-ME-openssl-rand-hex-32

# ── Tenant master key encryption (Fernet) ─────────────────────────
# Generate on the VPS:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ⚠️  BACK THIS UP in a password manager AND on paper.  Losing it
#     makes every encrypted video in every tenant unrecoverable.
SERVER_ENCRYPTION_KEY=CHANGE-ME-fernet-key

# ── Admin API key (internal; any random string) ───────────────────
ADMIN_API_KEY=CHANGE-ME-random-string

# ── CORS — the dashboard's Vercel URL ─────────────────────────────
# Comma-separated if you have multiple environments.
# Example: https://admin.yourplatform.com,https://preview-xyz.vercel.app
ALLOWED_ORIGINS=https://admin.yourplatform.com

# ── Device policy defaults (optional; these are the defaults) ─────
DEFAULT_MAX_DEVICES=2
DEFAULT_MAX_DEVICE_CHANGES_PER_30D=2
DEFAULT_OFFLINE_GRACE_DAYS=20
