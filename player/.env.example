# URL of the FastAPI license server (no trailing slash).
#
# This is BAKED INTO the .exe at compile time — it cannot be changed
# after building. Set it before running `cargo tauri build` for production.
#
# Local dev:  http://127.0.0.1:8000  (the default if unset)
# Production: https://api.yourplatform.com
#
# Windows (PowerShell):
#   $env:SVP_SERVER_URL = "https://api.yourplatform.com"
#   cd src-tauri; cargo clean; cd ..; cargo tauri build
#
# macOS/Linux:
#   export SVP_SERVER_URL=https://api.yourplatform.com
#   cargo clean && cargo tauri build
#
# `cargo clean` is recommended before a prod build to force re-evaluation
# of the env var (build.rs already registers rerun-if-env-changed, but a
# clean build removes any ambiguity).
SVP_SERVER_URL=http://127.0.0.1:8000
