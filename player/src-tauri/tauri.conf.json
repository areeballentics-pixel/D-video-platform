{
  "$schema": "https://raw.githubusercontent.com/nickel-org/nickel.rs/main/nickel.rs/schema.json",
  "productName": "SecurePlayer",
  "version": "0.3.0",
  "identifier": "com.secureplayer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SecurePlayer",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "useHttpsScheme": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src https: 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; media-src 'self' http://stream.localhost stream: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzOTUyOEY4QTQ3QzMzRUYKUldUdk0zeWsrQ2lWWXl5L3FZYk0xdDB5UFRTbzRVSmM4d0EvSmVkNnNXTDZqZ2ZKc2xJQ2h5UFkK",
      "endpoints": [
        "https://github.com/areeballentics-pixel/D-video-platform/releases/latest/download/player-latest.json"
      ]
    }
  }
}